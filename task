#!/usr/bin/env sh
#
# SKYWARD — single entry point monorepo task runner (aligned with modular monorepo spec).
#
#   ./task check              go vet + svelte-check + lint
#   ./task test               go test -race + vitest unit
#   ./task build              build Go binary (apps/api) + static client (apps/web)
#   ./task db:migrate         run SQL migrations (scripts/migrate.sh)
#   ./task db:drift           check database schema drift (scripts/drift-check.sh)
#   ./task db:tunnel [cmd]    manage VPS DB test SSH tunnel (up|down|status)
#   ./task help
#
# Pure POSIX script without external tooling dependencies.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT"

BUILD="$ROOT/.build"
BIN="$BUILD/bin"
RUN="$ROOT/.local/run"
mkdir -p "$BUILD" "$BIN" "$RUN"

TUNNEL_SOCKET="$RUN/ssh_tunnel.sock"
VPS_HOST="43.133.148.191"
VPS_USER="sachiel"
LOCAL_DB_PORT="15432"

log()  { printf '\n== %s\n' "$*"; }
info() { printf '   %s\n' "$*"; }
ok()   { printf '   ok: %s\n' "$*"; }
die()  { printf '\n!! FAILED: %s\n' "$*" >&2; exit 1; }

task_check() {
  log "Running monorepo static checks & linters"
  
  info "1. Backend Go vet..."
  (cd "$ROOT/apps/api" && go vet ./...) || die "go vet failed"
  ok "Go vet clean"

  info "2. Frontend Svelte check..."
  pnpm --filter skyward-web check || die "svelte-check failed"
  ok "Svelte check clean"

  if command -v gitleaks >/dev/null 2>&1; then
    info "3. Secret leak scan (gitleaks)..."
    gitleaks protect --staged --verbose 2>/dev/null || gitleaks detect --no-git 2>/dev/null || true
    ok "Gitleaks scan complete"
  fi

  ok "All monorepo static checks passed!"
}

task_test() {
  log "Running monorepo test suite"
  
  info "1. Backend unit tests (race detector)..."
  (cd "$ROOT/apps/api" && go test -race ./...) || die "go test failed"
  ok "Backend Go tests passed"

  info "2. Frontend web tests (vitest)..."
  pnpm --filter skyward-web test || die "web tests failed"
  ok "Frontend web tests passed"

  ok "All monorepo unit tests passed!"
}

task_build() {
  log "Building binary and static web artifacts"
  
  info "1. Backend skyward-api..."
  (cd "$ROOT/apps/api" && go build -o "$BIN/skyward-api" ./cmd/server) || die "build skyward-api failed"
  ok "Binary built: .build/bin/skyward-api"

  info "2. Frontend skyward-web..."
  pnpm --filter skyward-web build || die "build web failed"
  ok "Static web built: apps/web/build"

  ok "All builds completed successfully!"
}

task_db_migrate() {
  log "Running database migrations"
  "$ROOT/scripts/migrate.sh" "$@"
}

task_db_drift() {
  log "Checking database schema drift"
  "$ROOT/scripts/drift-check.sh" "$@"
}

task_db_tunnel() {
  subcmd="${1:-status}"
  case "$subcmd" in
    up|start)
      if [ -S "$TUNNEL_SOCKET" ] && ssh -S "$TUNNEL_SOCKET" -O check "$VPS_HOST" 2>/dev/null; then
        info "SSH tunnel is already active on port 127.0.0.1:$LOCAL_DB_PORT"
        return 0
      fi
      log "Opening SSH tunnel to VPS ($VPS_HOST) for PostgreSQL port $LOCAL_DB_PORT -> 5432..."
      ssh -M -S "$TUNNEL_SOCKET" -f -N -L "$LOCAL_DB_PORT:127.0.0.1:5432" "$VPS_USER@$VPS_HOST" || die "Failed to open SSH tunnel"
      info "Use port $LOCAL_DB_PORT for TEST_DATABASE_URL (see ARCHITECTURE.md)"
      ;;
    down|stop)
      log "Closing SSH tunnel..."
      if [ -S "$TUNNEL_SOCKET" ]; then
        ssh -S "$TUNNEL_SOCKET" -O exit "$VPS_HOST" 2>/dev/null || true
        rm -f "$TUNNEL_SOCKET"
        ok "SSH tunnel closed"
      else
        info "No active tunnel found"
      fi
      ;;
    status)
      if [ -S "$TUNNEL_SOCKET" ] && ssh -S "$TUNNEL_SOCKET" -O check "$VPS_HOST" 2>/dev/null; then
        ok "SSH tunnel active (127.0.0.1:$LOCAL_DB_PORT -> VPS:5432)"
      else
        info "SSH tunnel inactive / down"
      fi
      ;;
    *)
      die "Usage: ./task db:tunnel [up|down|status]"
      ;;
  esac
}

task_help() {
  cat <<'EOF'
Skyward Task Runner — single entry point monorepo task runner

Usage:
  ./task check              Run static checks (go vet, svelte-check)
  ./task test               Run test suite (go test -race, pnpm test)
  ./task build              Build Go binary and SvelteKit static bundle
  ./task db:migrate [arg]   Run database migrations
  ./task db:drift           Check database schema drift
  ./task db:tunnel [up|down|status]
                            Manage SSH tunnel port forwarding to VPS test DB
  ./task help               Show this help message
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  check) task_check "$@" ;;
  test) task_test "$@" ;;
  build) task_build "$@" ;;
  db:migrate) task_db_migrate "$@" ;;
  db:drift) task_db_drift "$@" ;;
  db:tunnel) task_db_tunnel "$@" ;;
  help|--help|-h) task_help ;;
  *) die "Unknown command: $cmd. Run './task help' for available commands." ;;
esac
